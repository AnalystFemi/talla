# ===== TALLA — copy to .env and fill. NEVER commit real keys. =====
# Local: `npm run dev:api` loads this file (node --env-file=../.env).
# Deployed Worker: set each SECRET with `wrangler secret put NAME`
# (plain vars live in wrangler.toml [vars]). See docs/deploy-checklist.md.

# 0. Access (who may spend paid credits)
#    Without a matching X-Talla-Access header every request runs in DEMO mode
#    ($0: paid keys/endpoints are stripped). Unset = nobody can run live.
TALLA_ACCESS_CODE=
#    LOCAL DEV ONLY: "1" authorises every request without a code.
#    NEVER set this on the deployed Worker.
TALLA_DEV_OPEN=
#    CORS: comma-separated browser origins (http://localhost:5173 is always
#    allowed). On the Worker this is a [vars] entry in wrangler.toml.
ALLOWED_ORIGINS=

# 1. Baseten — Muse Spark Open (research / storyboard / script / critic / export)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# 2. Meta — Muse Image keyframes, SAM 3.1 keyframe QC, Muse Voice Transcribe verify
META_API_KEY=
#    Optional overrides (code defaults shown)
META_BASE_URL=https://api.meta.ai/v1
MUSE_IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# 3. Research enrichment (shared $5 cap)
FIRECRAWL_API_KEY=
EXA_API_KEY=

# 4. Modal — GPU media. Every endpoint requires X-Talla-Token.
#    MODAL_ENDPOINT_TOKEN must equal TALLA_ENDPOINT_TOKEN in the Modal secret
#    `talla-endpoint-auth` (create that secret BEFORE `modal deploy`).
#    Run locally once: modal token new  (CLI auth is stored by Modal, not here)
MODAL_ENDPOINT_TOKEN=
#    Wan 2.2 (primary) + LTX 2.5 (fallback) — talla-wan app, spawn + result
MODAL_WAN_ENDPOINT=
MODAL_WAN_RESULT_ENDPOINT=
#    InfiniteTalk lip-sync (talla-talk) — keyed off until the WP-C smoke test
#    passes; spawn + result. Stitch keeps clip audio, no WAV re-mux.
MODAL_TALK_ENDPOINT=
MODAL_TALK_RESULT_ENDPOINT=
#    Stitch (talla-stitch): spawn + result + file_http (serves finished media
#    through the Worker at /api/media/file/:name; also used by verify)
MODAL_STITCH_ENDPOINT=
MODAL_STITCH_RESULT_ENDPOINT=
MODAL_FILE_ENDPOINT=
#    Voices: YarnGPT2 (Yoruba/Hausa/Igbo/Nigerian English) + MMS (Pidgin)
MODAL_YARN_ENDPOINT=
MODAL_TTS_ENDPOINT=
#    MiniMax H3 and lipsync are PARKED — no route submits them; no vars needed.

# 5. Cloudflare — deploy tooling only (NOT Worker secrets)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=talla-media
D1_DATABASE=talla

# 6. Scripts only (not read by the Worker)
#    API_BASE   — target for scripts/smoke.mjs and calibrate_wan.mjs (default http://localhost:8787)
#    YARNGPT_API_KEY — hosted YarnGPT reference scripts (scripts/yarngpt_*.mjs); hosted calls are stopped
YARNGPT_API_KEY=

# Local dev
PORT=8787

# ----- Web build (web/.env or shell, not this file) -----
# VITE_API_URL  — Worker origin baked into the production build,
#                 e.g. https://talla-api.<subdomain>.workers.dev (empty = same origin / dev proxy)
# DEV_API_PROXY — Vite dev proxy target for /api (default http://localhost:8787)
