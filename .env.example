# ===== TALLA — copy to .env and fill. NEVER commit real keys. =====

# 1. Baseten — Muse Spark Open (agent brain: research/storyboard/script/critic)
#    Get: https://app.baseten.co -> API Keys. You have $100 credit.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# 2. Meta Muse — Muse Image keyframes + high-stakes Spark calls ($150 credit, preserve)
#    Get: hackathon Meta credits dashboard given by organisers.
META_API_KEY=
META_BASE_URL=
MUSE_IMAGE_MODEL=muse-image-1.0

# 3. Firecrawl — URL scrape + deep research. Get: https://firecrawl.dev
FIRECRAWL_API_KEY=

# 4. Exa — semantic search. Get: https://exa.ai
EXA_API_KEY=

# 5. Ava Studio MCP — for REA research into Ava's flow. Get: Ava Studio account settings.
AVA_API_KEY=

# 6. Modal — GPU media (Wan 2.2/LTX primary silent motion, YarnGPT2 + MMS voices,
#    stitch). Each app exposes paired spawn + result endpoints (async jobs).
#    Run locally once:  modal token new   (tokens stored by Modal CLI, not here)
MODAL_WAN_ENDPOINT=
MODAL_WAN_RESULT_ENDPOINT=
MODAL_STITCH_ENDPOINT=
MODAL_STITCH_RESULT_ENDPOINT=
MODAL_YARN_ENDPOINT=
MODAL_TTS_ENDPOINT=
# Parked/optional — MiniMax H3 is ON HOLD and never submitted by /generate;
# set only to experiment with it, plus MODAL_VIDEO_ENDPOINT is unused/legacy.
MODAL_H3_ENDPOINT=
MODAL_H3_RESULT_ENDPOINT=
MODAL_VIDEO_ENDPOINT=

# 7. Cloudflare — deploy only (Wrangler is already logged in locally)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=talla-media
D1_DATABASE=talla

# Optional fallbacks (leave empty unless the Modal voice/engine tests fail)
MINIMAX_API_KEY=
YARNGPT_API_KEY=

# Local dev
PORT=8787
